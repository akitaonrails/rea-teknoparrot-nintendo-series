+    #[test]
+    fn the_aim_that_moved_last_wins_and_pointer_buttons_add() {
+        let state = |x: i16, buttons: u32| {
+            let mut f = InputFrame::default();
+            f.players[0].axes[Axis::LeftX as usize] = x;
+            f.players[0].buttons = buttons;
+            f
+        };
+        let mut a = Aiming::default();
+        // no pointer: the frontend's frame as it is
+        assert_eq!(a.merge(state(5, 1), None), state(5, 1));
+        // the mouse moves: its aim; its trigger adds to the frontend's buttons
+        assert_eq!(a.merge(state(5, 1), Some(state(-300, 2))), state(-300, 3));
+        assert_eq!(a.merge(state(5, 0), Some(state(-300, 0))), state(-300, 0));
+        // the frontend's stick moves: its aim again
+        assert_eq!(a.merge(state(9, 0), Some(state(-300, 0))), state(9, 0));
+    }
