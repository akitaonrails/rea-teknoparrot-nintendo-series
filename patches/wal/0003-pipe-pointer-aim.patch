+    /// The lightguns' and mice's virtual sticks alone (`--input-pipe`: a frontend drives the
+    /// rest); `None` without one.
+    pub fn pointer_frame(&self) -> Option<InputFrame> {
+        let deadzone = self.config.input.deadzone;
+        let sticks: Vec<_> = self
+            .devices
+            .iter()
+            .filter(|(k, _)| matches!(k, DevKey::Pointer(_)))
+            .map(|(_, d)| (d.player, d.contribution(deadzone)))
+            .collect();
+        (!sticks.is_empty()).then(|| mapping::merge_sticks(sticks.into_iter(), deadzone, self.config.input.stick_as_dpad))
+    }
