+/// Which aim each player follows: the frontend's sticks or a lightgun / mouse.
+#[derive(Default)]
+pub struct Aiming {
+    last_pipe: [[i16; 2]; MAX_PLAYERS],
+    last_pointer: [[i16; 2]; MAX_PLAYERS],
+    pointer: [bool; MAX_PLAYERS],
+}
+
+fn aim(s: &StickState) -> [i16; 2] {
+    [s.axes[Axis::LeftX as usize], s.axes[Axis::LeftY as usize]]
+}
+
+impl Aiming {
+    pub fn merge(&mut self, mut frame: InputFrame, pointers: Option<InputFrame>) -> InputFrame {
+        let Some(pointers) = pointers else { return frame };
+        for (p, (stick, from_pointer)) in frame.players.iter_mut().zip(&pointers.players).enumerate() {
+            let (a, b) = (aim(stick), aim(from_pointer));
+            if b != self.last_pointer[p] {
+                self.pointer[p] = true;
+            } else if a != self.last_pipe[p] {
+                self.pointer[p] = false;
+            }
+            (self.last_pipe[p], self.last_pointer[p]) = (a, b);
+            stick.buttons |= from_pointer.buttons;
+            if self.pointer[p] {
+                stick.axes[Axis::LeftX as usize] = b[0];
+                stick.axes[Axis::LeftY as usize] = b[1];
+            }
+        }
+        frame
+    }
+}
